# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/ai_life_manager
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_EXPIRES_IN=30d

# AI LLM Provider Keys (At least one recommended)
GOOGLE_API_KEY=your_gemini_api_key
MISTRALAI_API_KEY=your_mistral_api_key
COHERE_API_KEY=your_cohere_api_key

# AI Orchestration Settings
AI_MODE=fallback
AI_PROVIDER_ORDER=gemini,mistral,cohere
